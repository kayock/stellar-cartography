# Stellar Cartography — example environment (copy to .env and adjust).
# The app also accepts CLI flags; flags override these defaults when both are set.
#
# Do NOT put secrets here. Narration/TTS and Stellarium URLs are local-network
# endpoints, not cloud API keys.

# Bind interface and port for the Cartography web UI
# STELLAR_CARTOGRAPHY_HOST=127.0.0.1
# STELLAR_CARTOGRAPHY_PORT=8775

# Stellarium Remote Control base URL (no trailing path required)
# STELLAR_CARTOGRAPHY_STELLARIUM_URL=http://127.0.0.1:8090

# Optional: extra hosts allowed for local Father Fox / Kayock Voice HTTPS TTS
# (comma-separated). Loopback is always allowed. Leave unset for public/default.
# STELLAR_CARTOGRAPHY_TTS_HOSTS=
